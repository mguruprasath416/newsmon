# ===========================================
# ClarityTI - Environment Variables Template
# Copy to .env and fill in values
# ===========================================

# ── Application ─────────────────────────────
ENVIRONMENT=development
APP_NAME=ClarityTI
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=info

# ── API Server ───────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── JWT Authentication ────────────────────────
JWT_SECRET_KEY=change-me-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MongoDB ───────────────────────────────────
MONGODB_URL=mongodb://localhost:27017/
MONGODB_DB_NAME=clarityti
MONGO_USER=admin
MONGO_PASSWORD=secret

# ── Elasticsearch ─────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=clarityti

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── OpenAI ────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4.1
OPENAI_MAX_TOKENS=8000
OPENAI_TEMPERATURE=0.1

# ── Microsoft Teams Integration ───────────────
TEAMS_WEBHOOK_URL_CYBER_PULSE=

# ── Object Storage (MinIO / S3) ───────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=clarityti
MINIO_USE_SSL=false
# For AWS S3 production:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=clarityti-prod
# AWS_REGION=us-east-1

# ── Email (SES / SMTP) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@clarityti.io
EMAIL_FROM_NAME=ClarityTI

# ── External APIs ─────────────────────────────
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
NVD_API_KEY=
EPSS_API_URL=https://api.first.org/data/v1/epss
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_DEFAULT=1000
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_LENS=10

# ── File Upload ───────────────────────────────
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_TYPES=pdf,txt,md,html,json

# ── Sentry (APM) ──────────────────────────────
SENTRY_DSN=
